# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WhatsApp provider: "meta" (Meta Cloud API) or "twilio". Unset defaults to twilio.
WHATSAPP_PROVIDER=meta

# ── Meta Cloud API (active) ──
# WhatsApp Manager -> Account tools. Token should be a permanent System User token
# with whatsapp_business_messaging + whatsapp_business_management.
META_WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
META_WHATSAPP_TOKEN=your_meta_system_user_token
META_WHATSAPP_API_VERSION=v21.0

# ── WhatsApp via Twilio (fallback — set WHATSAPP_PROVIDER=twilio to use) ──
# Get from: Twilio Console → Account Info
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=+your_twilio_whatsapp_number
# Uncomment and fill when templates are approved:
# TWILIO_OTP_TEMPLATE_SID=HXxxx
# TWILIO_WAITLIST_TEMPLATE_SID=HXxxx

# WhatsApp Webhook verify token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token

# Booklyt customer app platform
# Production universal-link domain (QR codes, deep links, .well-known files derive from NEXT_PUBLIC_APP_URL above)
# Android App Links: comma-separated SHA-256 fingerprints of your release (and debug) signing certs
ANDROID_CERT_SHA256_FINGERPRINTS=
# iOS Universal Links: your Apple Developer Team ID
APPLE_TEAM_ID=
# Native push (FCM): full service-account JSON (single line) from Firebase console
FIREBASE_SERVICE_ACCOUNT_JSON=
# Secret required by /api/cron/* reminder routes
CRON_SECRET=

# Booking verification (showcase build ships with this OFF).
# Set to "true" to enable per-business WhatsApp OTP / confirmation-link verification.
NEXT_PUBLIC_BOOKING_VERIFICATION_ENABLED=false
