# ---------------------------------------------------------------------------
# Bakery operations platform — environment
#
# Every value here is OPTIONAL. This build runs on an in-memory demo backend,
# so `npm install && npm run dev` works with no .env file at all.
#
# There are no secrets in this project, and none should ever be added to this
# file — it is committed.
# ---------------------------------------------------------------------------

# Seed for the fictional dataset. The same value always produces the same demo
# data, which is what makes screenshots and tests reproducible.
DEMO_SEED=20260101

# HMAC key for the staff passcode-session cookies (workers / production /
# driver). Production requires a long random value here and refuses to start
# without one; the demo falls back to a published development key, which is
# safe only because there is no real session to forge. Set this to restore the
# production behaviour.
KIOSK_SESSION_SECRET=

# Public base URL, e.g. https://your-deployment.vercel.app
# Used for links that leave the building — the attendance enrolment QR code and
# its WhatsApp link. Without it the link is built from whatever host the
# browser happens to be on.
NEXT_PUBLIC_APP_URL=

# Web Push (VAPID) for new-order alerts on the baker and driver screens.
# Generate a pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Left empty, the apps fall back to in-page alerts and skip background push.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
